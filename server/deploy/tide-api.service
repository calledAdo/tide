[Unit]
Description=TIDE testnet API and keeper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tide
WorkingDirectory=/opt/tide/server
EnvironmentFile=/etc/tide/tide-api.env
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5
MemoryMax=200M
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tide
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
